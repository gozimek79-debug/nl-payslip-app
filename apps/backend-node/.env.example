DATABASE_URL=postgresql://admin:secure_password_123@localhost:5432/payslip_analyzer
REDIS_URL=redis://localhost:6379
GROQ_API_KEY=your-groq-key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Stage 2t (audit v52, owner's 29 September decision, §2t.2/§5.2): document READING - payslip
# extraction (ocr-client.ts) AND contract extraction (contract-client.ts) - goes through
# ai-service/gemini-client.ts, the ONE reader for every document shape (embedded-PDF, scan, photo
# alike). This retires Mistral Medium, Mistral OCR annotation, the 2s two-reader comparison, and the
# document-vision-provider.ts config surface entirely (TIER_C_VISION_PROVIDER, MISTRAL_API_KEY,
# MISTRAL_VISION_MODEL, OPENAI_API_KEY, OPENAI_VISION_MODEL - all gone, not merely unused) - there is
# no provider choice left to make and no dead switch left over (GEMINI_READER_ENABLED is retired too;
# reading is always on when GEMINI_API_KEY is set, never conditional on a second flag). GROQ_* above is
# unaffected - it still serves text explanations/translation via ai-client.ts, unrelated to reading.
#
# §5.2's own honesty requirement: reading is NOT EU-hosted (the ordinary Gemini API, not Vertex AI) -
# gemini-client.ts's own `readingProviderStatus()` and /api/health report this plainly, not a carried-
# over "EU-hosted" claim from the Mistral era. Quality over cost, per the owner's own instruction: the
# default model below is a genuine Gemini Pro-class model, confirmed live against this account's own
# model list (§2t.1), never substituted for a cheaper Flash/Lite one.
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.1-pro-preview
