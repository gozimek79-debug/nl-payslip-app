DATABASE_URL=postgresql://admin:secure_password_123@localhost:5432/payslip_analyzer
REDIS_URL=redis://localhost:6379
GROQ_API_KEY=your-groq-key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Stage 2c (audit v13): PRO's payslip extraction (tier-c-vision-provider.ts) is now a configurable
# provider, separate from the GROQ_* vars above (which still serve contract extraction, translation,
# and the orphaned old payslip route - unchanged this round). Set TIER_C_VISION_PROVIDER to one of
# groq | mistral | openai | gemini, and supply that provider's own API key below. Unset = groq
# (unchanged default) until Stage 2c's live comparison picks a winner.
# TIER_C_VISION_PROVIDER=mistral
# MISTRAL_API_KEY=your-mistral-key
# MISTRAL_VISION_MODEL=mistral-large-3
# OPENAI_API_KEY=your-openai-key
# OPENAI_VISION_MODEL=gpt-5
# GEMINI_API_KEY=your-gemini-key
# GEMINI_VISION_MODEL=gemini-3.1-pro-preview
