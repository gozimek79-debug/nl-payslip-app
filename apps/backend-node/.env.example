DATABASE_URL=postgresql://admin:secure_password_123@localhost:5432/payslip_analyzer
REDIS_URL=redis://localhost:6379
GROQ_API_KEY=your-groq-key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Stage 2c-v15 (audit): document READING - payslip extraction (ocr-client.ts) AND contract
# extraction (contract-client.ts) - now goes through document-vision-provider.ts, a configurable
# provider separate from the GROQ_* vars above (which still serve text explanations/translation via
# ai-client.ts, and the orphaned old payslip route - unchanged this round). Decided: Mistral
# (EU-hosted) is the reading model, and the code default now matches - unset TIER_C_VISION_PROVIDER
# and it uses Mistral, not Groq. Set to groq only as a local-dev fallback with no Mistral key handy.
# Gemini is NOT a valid value here (it is not a selectable single reading provider) - see the Gemini
# reader block below for its own, separate, narrower role (stage 2s). The env var name itself stays
# TIER_C_VISION_PROVIDER even though it now also governs contract extraction - it is already live in
# Vercel production under that name, and renaming it would silently break that config.
TIER_C_VISION_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-key
# MISTRAL_VISION_MODEL=mistral-large-3
# OPENAI_API_KEY=your-openai-key
# OPENAI_VISION_MODEL=gpt-5

# Stage 2s (audit v51, §2s.1c/§5.2): Gemini as READER B for the image-only path only (a photo or a
# scan with no embedded PDF text) - a second, independent reading compared line-by-line against
# Mistral's own OCR annotation (reader-comparison.ts). Document images reach Google's servers OUTSIDE
# the EU on this path (the ordinary Gemini API, not Vertex AI) - accepted for development and the
# owner's own test documents only, per the owner's own 28 September decision; §5.5 gates real-user
# launch on three conditions (a PII filter before Gemini sees a page, the paid API tier, and updated
# privacy copy), none met yet. This does NOT reopen Gemini as a document-analysis input (still figures-
# only, payslip-analysis-payload.ts, unchanged) and does NOT make Gemini a TIER_C_VISION_PROVIDER
# value - it is a narrower, separately-switched, deliberately non-EU exception for this one path only.
# GEMINI_API_KEY already exists in Vercel production (set by the owner before this stage - reused, not
# a new key; confirmed via `vercel env ls`, name only, value never read into this repo or a report).
GEMINI_API_KEY=your-gemini-key
GEMINI_READER_ENABLED=false
# GEMINI_MODEL=gemini-3.8-flash
