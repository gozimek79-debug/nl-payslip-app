{
  "buildCommand": "npm run build --workspace @nl-payslip/frontend",
  "outputDirectory": "apps/frontend-react/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/maintenance/cleanup-expired", "schedule": "0 3 * * *" }
  ]
}
